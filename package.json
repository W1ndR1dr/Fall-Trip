{
  "name": "fall-trip",
  "version": "2.0.0",
  "private": true,
  "description": "Fall Trip: an offline-first family guide for an Eastern Sierra fall color weekend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs",
    "topo": "node scripts/topo.mjs",
    "test:offline": "node scripts/test-offline.mjs",
    "update": "node scripts/update-conditions.mjs && npm run build",
    "relief": "node scripts/relief.mjs",
    "contrast": "node scripts/contrast.mjs",
    "shoot": "node scripts/shoot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/andika": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vaul": "^1.1.2",
    "wouter": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-contour": "^4.0.2",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
